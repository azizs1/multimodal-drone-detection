### Variables
@baseUrl = http://localhost:8000
@incidentId = 54946ce7-d9e0-4ea4-8861-720da837d74a

### -----------------------------------------------------------------
### Create incident from fused inference (single object)
### -----------------------------------------------------------------
POST {{baseUrl}}/incidents
Content-Type: application/json

{
  "incident_id": "{{incidentId}}",
  "has_drone": true,
  "fused_confidence": 0.6580419778823853,
  "confidence_band": "medium",
  "decision": "none",
  "evidence": {
    "rgb": {
      "modality": "rgb",
      "timestamp": 1775329452.9548001,
      "bbox": [755.4943237304688, 463.0047912597656, 863.6148071289062, 555.74365234375],
      "class_id": "drone",
      "confidence": 0.5766928195953369,
      "embedding": null,
      "meta": { "sensor_id": "rgb_cam0" }
    },
    "thermal": {
      "modality": "thermal",
      "timestamp": 1775329452.9548001,
      "bbox": [252.14231872558594, 264.61376953125, 295.2435302734375, 300.427978515625],
      "class_id": "drone",
      "confidence": 0.7800657153129578,
      "embedding": null,
      "meta": { "sensor_id": "thermal_cam0" }
    }
  },
  "per_modality_scores": {
    "rgb": 0.5766928195953369,
    "thermal": 0.7800657153129578
  },
  "thresholds": {
    "alert": 0.75,
    "hold": 0.55
  },
  "gating_reason": "rgb+thermal",
  "latency_ms": 0.0069141387939453125,
  "media": {
    "rgb": null,
    "thermal": null
  },
  "objects": [
    {
      "object_id": "rgb-0",
      "modality": "rgb",
      "class_id": "drone",
      "confidence": 0.5766928195953369,
      "bbox": [755.4943237304688, 463.0047912597656, 863.6148071289062, 555.74365234375],
      "timestamp": 1775329452.9548001
    },
    {
      "object_id": "thermal-1",
